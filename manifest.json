{
  "manifest_version": 3,
  "name": "BobbleVR — Head-Tracked YouTube VR Viewer",
  "version": "1.1.0",
  "description": "Watch YouTube 360° and VR180 videos with webcam head tracking. Move your head to look around, lean in to zoom.",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://storage.googleapis.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "BobbleVR",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["mse-hook-loader.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "overlay.js",
        "overlay.css",
        "face-worker.html",
        "face-worker.js",
        "mse-hook.js",
        "lib/three.module.js",
        "lib/mediapipe-vision_bundle.mjs",
        "lib/mediapipe-wasm/*"
      ],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
